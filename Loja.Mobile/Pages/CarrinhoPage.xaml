<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:Loja.Mobile.Models"
    x:Class="Loja.Mobile.Pages.CarrinhoPage"
    Title="Meu carrinho">

    <Grid
        Padding="20"
        RowDefinitions="Auto,*,Auto,Auto"
        RowSpacing="14">

        <Label
            Text="Meu carrinho"
            FontSize="26"
            FontAttributes="Bold" />

        <CollectionView
            x:Name="ItensView"
            Grid.Row="1"
            SelectionMode="None">

            <CollectionView.EmptyView>
                <Label
                    Text="Seu carrinho está vazio."
                    Margin="0,20" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ItemCarrinho">
                    <Border
                        Padding="14"
                        Margin="0,0,0,10"
                        Stroke="#CCCCCC">

                        <VerticalStackLayout Spacing="8">
                            <Label
                                Text="{Binding Nome}"
                                FontSize="18"
                                FontAttributes="Bold" />

                            <Label
                                Text="{Binding Quantidade, StringFormat='Quantidade: {0}'}" />

                            <Label
                                Text="{Binding SubtotalFormatado, StringFormat='Subtotal: {0}'}" />

                            <HorizontalStackLayout Spacing="10">
                                <Button
                                    Text="Alterar quantidade"
                                    Clicked="AlterarClicked" />

                                <Button
                                    Text="Remover"
                                    Clicked="RemoverClicked" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label
            x:Name="TotalLabel"
            Grid.Row="2"
            FontSize="22"
            FontAttributes="Bold" />

        <VerticalStackLayout
            Grid.Row="3"
            Spacing="10">

            <Entry
                x:Name="ObservacaoEntry"
                Placeholder="Observação para a loja (opcional)"
                MaxLength="300" />

            <Button
                x:Name="FinalizarButton"
                Text="Confirmar pedido"
                Clicked="FinalizarClicked" />

            <Label x:Name="MensagemLabel" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>